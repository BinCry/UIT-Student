{
  "name": "uit-portal-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "dependencies": {
    "expo": "^54.0.36",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prepare:android:release": "node ./scripts/prepare-android-release.mjs",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:android:local": "npx eas-cli build --platform android --profile production --local",
    "build:android:release-local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1"
  },
  "private": true
}
